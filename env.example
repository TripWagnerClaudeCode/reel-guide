# reel-guide settings. install.sh copies this to ~/.config/reel-guide/env (mode 0600).
# Both the CLI and the server read that file. Variables already set in your shell win.
# Lines are KEY=VALUE; leave a value empty to use the default.

# Where finished guides are saved (default: ~/Reel Guides)
REEL_GUIDE_OUT_DIR=

# Scratch files per reel (default: <repo>/work)
REEL_GUIDE_WORK_DIR=

# Instagram cookies exported from a THROWAWAY account (default: <repo>/cookies.txt)
REEL_GUIDE_COOKIES=

# Path to the claude CLI if it isn't on PATH (default: found automatically)
REEL_GUIDE_CLAUDE=

# Optional: describe your own machine/tools so guides say how to fit the project in
# (default: <repo>/my_setup.md; see my_setup.example.md)
REEL_GUIDE_CONTEXT=

# --- Server (phone share sheet)
# Addresses to listen on, comma-separated. Keep 127.0.0.1 first. Add your Tailscale IP
# (tailscale ip -4) so your phone can reach it. Avoid 0.0.0.0. See docs/MOBILE.md.
REEL_GUIDE_BIND=127.0.0.1
REEL_GUIDE_PORT=8765

# --- Push notifications via ntfy (optional; leave TOPIC empty to turn off)
# On public ntfy.sh anyone who knows the topic can read it: use a long random name,
# e.g. reel-guide-$(openssl rand -hex 12)
REEL_GUIDE_NTFY_TOPIC=
REEL_GUIDE_NTFY_SERVER=https://ntfy.sh
REEL_GUIDE_NTFY_TOKEN=
# Hold pushes during these hours (24h clock, local time), e.g. 23-8
REEL_GUIDE_QUIET_HOURS=
